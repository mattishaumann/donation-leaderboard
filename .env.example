KOFI_TOKEN=your_kofi_verification_token_here

# AI song extraction — Gemini tried first, GPT-4o-mini used as fallback
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Spotify — create app at developer.spotify.com
# Set redirect URI to: http://127.0.0.1:3000/auth/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
